{
  "name": "cw-manutencao",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "test": "npm run test:v2 && npm run test:legacy",
    "test:v2": "vitest run --config vitest.config.ts",
    "test:v2:watch": "vitest --config vitest.config.ts",
    "test:legacy": "node --check app.js && node --check multiempresa.js && node --check arquitetura-v2.js && node tests/multiempresa.test.mjs && node tests/interface.test.mjs && node tests/interface-v2.test.mjs && node tests/admin-users.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
