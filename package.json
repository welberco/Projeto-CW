{
  "name": "cw-manutencao",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src tests/e2e scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "npm run test:v2:unit && npm run test:legacy",
    "test:v2": "npm run test:v2:unit",
    "test:v2:unit": "vitest run --config vitest.config.ts",
    "test:v2:watch": "vitest --config vitest.config.ts",
    "test:v2:e2e": "playwright test --config playwright.config.ts",
    "test:v2:db": "node scripts/supabase-local.mjs smoke",
    "test:v2:db:w3c:concurrency": "node scripts/w3c-concurrency-test.mjs",
    "test:v2:db:w3d:concurrency": "node scripts/w3d-concurrency-test.mjs",
    "test:v2:db:w3d:runner": "node scripts/w3d-runner-test.mjs",
    "test:v2:db:w3e:adversarial": "node scripts/w3e-adversarial-test.mjs",
    "test:v2:db:w4a:concurrency": "node scripts/w4a-concurrency-test.mjs",
    "ops:w3d:run-once": "node scripts/w3d-local-runner.mjs once",
    "test:v2:db:w1c:embedded": "node scripts/w1c-embedded-migration-check.mjs",
    "test:v2:all": "npm run test:v2:unit && npm run test:v2:db && npm run test:v2:e2e",
    "preflight:v2": "node scripts/v2-preflight.mjs",
    "verify:v2": "node scripts/verify-v2.mjs",
    "verify:v2:full": "node scripts/verify-v2.mjs --require-db",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:types": "node scripts/supabase-local.mjs types",
    "ops:w1b:bootstrap": "node scripts/w1b-local-bootstrap.mjs",
    "test:legacy": "node --check app.js && node --check multiempresa.js && node --check arquitetura-v2.js && node tests/multiempresa.test.mjs && node tests/interface.test.mjs && node tests/interface-v2.test.mjs && node tests/admin-users.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
